# Copy outside the source tree to ~/.config/quality-command-center/.env,
# or set QCC_ENV_FILE to another private configuration file.
# Process environment variables override file values.
APP_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:8765
ALLOWED_HOSTS=127.0.0.1,localhost
# Hosted configuration: supply credentials through your secret manager.
DATABASE_URL=CHANGE_ME
DIRECT_DATABASE_URL=CHANGE_ME
SUPABASE_URL=CHANGE_ME
SUPABASE_SECRET_KEY=CHANGE_ME
NETLIFY_SITE_ID=CHANGE_ME
NETLIFY_JWS_SECRET=CHANGE_ME
